# Provisioned automatically by `vercel integration add neon` + `vercel env pull`.
DATABASE_URL=

# From Walmart Seller Center (seller.walmart.com) -> Account -> API key management.
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# Sign-in (optional). Leave all three blank and the app stays open, as before.
# Set the Clerk keys (dashboard.clerk.com -> API keys) and every page requires
# sign-in. Read at runtime, so the same build works on any host.
# See docs/systems/authentication.md.
AUTH_PROVIDER=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
